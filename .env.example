# nfc-scan configuration — copy to .env and edit. All values are optional;
# the defaults shown match the code. Nothing here is a secret by default.
# Load it however you run the service (e.g. systemd EnvironmentFile=, or `set -a; . ./.env`).
#
# Three things read this file and they parse it differently: systemd
# (EnvironmentFile=), a shell (`. ./.env`) and Docker Compose (env_file). So keep
# every comment on its own line, never after a value, and double-quote any value
# that contains a space.

# --- Database (backend/db.py) ---
# Dev container default is localhost:5433 (see README). Override to point elsewhere.
# Note: under `make up` (docker-compose) the backend reaches Postgres as host=db
# port=5432 — compose overrides this value, so leave it as-is for local runs.
DB_DSN="dbname=attendance user=attendance password=attendance host=localhost port=5433"

# --- Face match, Step 6 (backend/face.py) ---
FACE_MATCH_ENABLED=true
# cosine cutoff; calibrate from logs
FACE_THRESHOLD=0.5
# CAMERA_INDEX is optional. Left unset, the backend picks a camera itself: an external
# USB camera when one is plugged in, otherwise the built-in/laptop one. On Linux a
# built-in camera is recognised only by its name; when the name does not say so, the
# lowest /dev/video node is used. Set CAMERA_INDEX to pin a specific index. Run
# `make cameras` to see what is attached and which index is used.
# CAMERA_INDEX=0
# false -> prefer the built-in camera
# CAMERA_PREFER_EXTERNAL=false
# false -> never auto-select; use CAMERA_INDEX only
# CAMERA_AUTO=false
# Capture size asked of a live camera. Unset -> the driver's default (often 640x480).
# The A4tech FHD 1080P camera can do 1920x1080; larger frames cost CPU on the MacBook Air.
# On the MacBook Air set 640x480 (macOS may otherwise hand over full HD), then check on
# the Register page that a face at the kiosk is still above MIN_FACE_PX.
# The backend prints the size the camera actually gives when it differs.
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
CAMERA_WARMUP_FRAMES=5
CAMERA_PROBE_FRAMES=5
MIN_FACE_PX=80
# detector input; raise (448/640) for far/small faces
FACE_DET_SIZE=320
# drives BOTH face + liveness; auto-falls back to CPU
USE_GPU=false

# --- Liveness / anti-spoof, Step 7 (backend/liveness.py) ---
LIVENESS_ENABLED=true
# unset -> model argmax verdict; set a p_live cutoff after calibration
# LIVENESS_THRESHOLD=
# defaults to backend/models/anti_spoof
# LIVENESS_MODEL_DIR=

# --- Guardian email, Step 8 (backend/notify.py) ---
# true -> email guardians; false -> console-only
NOTIFY_EMAIL_ENABLED=false
# required to send
SMTP_HOST=
# 465 -> implicit SSL, otherwise STARTTLS
SMTP_PORT=587
# omit for an open relay / local debug server
SMTP_USER=
SMTP_PASSWORD=
# defaults to SMTP_USER
SMTP_FROM=
SMTP_STARTTLS=true
# seconds per try; less when less is left of the 60 s an entry's message has
SMTP_TIMEOUT=10
# Guardian SMS through Semaphore. While this is false no SMS leaves the machine and
# saving a guardian mobile records "SMS test skipped". Every SMS costs credits, and
# saving a mobile sends one check SMS.
NOTIFY_SMS_ENABLED=false
# The Semaphore account key. A secret: put it in .env only, never in this file.
SEMAPHORE_API_KEY=
# seconds per SMS try; less when less is left of the 60 s an entry's message has
SEMAPHORE_TIMEOUT=10
# Sender name every SMS starts with. It must be the name the provider approved.
SEMAPHORE_SENDER=SAFEHSCI
# Where the reader stands, as the guardian message words it: "... entered the Hua
# Siong College of Iloilo main guardpost on Nov 24, 2026 at 7:12 AM."
ENTRY_POINT="main guardpost"
# The date and time in the message are written in ATTENDANCE_TZ (see Attendance
# sessions below).
# Peak arrival window on the school clock, HH:MM, end not included. The notification
# report (GET /api/notifications/summary) gives latency for peak and off-peak apart.
PEAK_START=07:00
PEAK_END=07:30

# --- 2FA enforcement, Step 9 (backend/decision.py) ---
# true -> a failed 2nd factor is rejected (not counted present). The default only: the
# switch on the Settings page saves enforce_2fa, which wins until it is changed again.
ENFORCE_2FA=false

# --- Perception service, Step 30 / Flow track (backend/perception.py) ---
# Continuous camera-owner pipeline (detect -> track -> recognize once per track, and
# again after a track lost its face).
# Default ON: camera runs at boot, /tap logs card-only `unverified` and enqueues
# for async face correlation (matcher, Step 31). Set false for headless / no-cam.
PERCEPTION_ENABLED=true
# unset -> the camera selected above; set a video file to run offline
# PERCEPTION_SOURCE=
# IoU to associate a detection with an existing track
TRACK_IOU_THRESH=0.3
# frames a track survives unmatched before it's dropped
TRACK_MAX_MISSES=15
# loop-rate cap
PERCEPTION_FPS=15
# seconds between "[perception] N fps, detection N ms a frame, N camera frames skipped"
# lines in the log; 0 turns them off
PERCEPTION_STATS_SEC=30
# seconds between face events for a face that stays in view. A tap can claim an event
# from about 1 s before it or from the window after it, so a larger value gives more
# no_face results for people who tap and walk on
FACE_REFRESH_SEC=2.0
# seconds without a processed frame after which every face track is recognized again
TRACK_STALE_SEC=1.0
# failed camera reads in a row (about 0.1 s apart) before the camera is closed and reopened
CAMERA_MAX_MISSES=100
# seconds between tries to reopen a camera that stopped or is not plugged in
CAMERA_RETRY_SEC=5

# --- Tap↔face matcher, Step 31 (backend/matcher.py) ---
# Correlates buffered taps with recognized faces within the window (Hungarian).
# keep wider than serial-buffering tap delay (design-notes §3)
ASSOC_WINDOW_SEC=4
# debounce duplicate/held-card reads per uid
TAP_COOLDOWN_SEC=2
# cosine cutoff for tap↔face; defaults to FACE_THRESHOLD
# MATCH_THRESHOLD=
# One-to-many face search: naming a face with no tap, and the Lookup page
# (/api/search-face). Off for the study (PC-031): a face with no tap is left unnamed
# and the guard picks the student on the Review page. true turns the search back on.
FACE_SEARCH_ENABLED=false
# similarity to name a cardless tailgater when the search is on; defaults to FACE_THRESHOLD
# TAILGATE_NAME_THRESHOLD=
# how often the matcher resolves ripe taps/faces
RESOLVE_INTERVAL_SEC=0.5
# bounded face buffer (drop oldest under backpressure)
MAX_FACE_BUFFER=256
# how many face tracks the matcher remembers as already judged (drop oldest)
MAX_TAILGATED_TRACKS=512
# seconds a judged face is remembered after last seen: the same face on a new track (the
# tracker lost the person when frames stalled) is not flagged again. 0 turns it off
DWELL_GAP_SEC=60
# similarity to a remembered face to count as the same person; defaults to the larger
# of MATCH_THRESHOLD and 0.6
# DWELL_THRESHOLD=

# --- Register guided-capture gate (GET /api/perception/state, Register.tsx) ---
# Live quality check from perception's own detections; drives capture-button gating.
# mean face brightness (0–255) below this -> "not enough light"
REGISTER_BRIGHT_LOW=55
# above this -> "too bright / backlit"
REGISTER_BRIGHT_HIGH=215
# face-center offset (0 centered .. 1 edge) above this -> "center yourself"
REGISTER_CENTER_MAX=0.45

# --- Identity & matching, Step 33 (backend/enroll.py) ---
# cosine at/above which enroll warns of a duplicate; defaults to FACE_THRESHOLD
# DUP_ENROLL_THRESHOLD=
# flag references older than N days for re-enroll (0 = off)
REENROLL_AFTER_DAYS=0

# --- Privacy & compliance, Step 20 (backend/privacy.py) ---
# Consent gate for minors' biometrics. OFF by default (dev/back-compat); turn ON in
# production BEFORE enrolling real children — then enroll + face match require a
# recorded face_consent (taps still log NFC-only without it).
FACE_CONSENT_REQUIRED=false
# Data retention (0/unset = keep forever). Applied by `make purge` (or a cron).
# delete whole logs older than N days
ATTENDANCE_RETENTION_DAYS=0
# null raw face/liveness scores older than N days (keep the row)
SCORE_RETENTION_DAYS=0

# --- Attendance sessions, Step 21 (backend/db.py) ---
# Time zone that days and LATE_CUTOFF are counted in, as an IANA name. Unset -> the
# zone of the machine the backend runs on. Set it when that machine's clock is not the
# school's, e.g. under Docker Compose, where the backend container runs on UTC.
# ATTENDANCE_TZ=Asia/Manila
# HH:MM cutoff for "late" marking on first check-in (empty = disabled)
LATE_CUTOFF=08:00

# --- Debug only (backend/main.py) ---
# Saves one annotated JPEG per present/spoof/tailgating outcome to
# backend/debug_snapshots/ (gitignored), for eyeballing liveness calibration. This
# project otherwise never writes a face photo to disk — leave this off except for a
# test/dev calibration session; never turn it on for a real pilot with real students.
DEBUG_SAVE_SNAPSHOTS=false

# --- Operator API + live tap stream, Step 11 (backend/main.py) ---
# Shared token guarding /api/* (reads + writes). Unset -> API is OPEN (dev only).
# Set a long random value in production. WebSocket /ws/taps passes it as ?token=.
# Send on REST as `Authorization: Bearer <token>` or `X-Operator-Token: <token>`.
OPERATOR_TOKEN=

# --- Serial reader (backend/serial_reader.py) ---
# TAP_URL=http://localhost:8001/tap
# Where taps that could not be posted wait. Erasing a student also removes the card's
# lines from this file, so the backend has to be given the same path as the reader.
# FAILED_TAPS_QUEUE=backend/failed_taps.jsonl
#
# SERIAL_PORT is optional. Left unset, the reader opens /dev/ttyACM0 when that exists
# and otherwise finds the board itself (preferring known USB vendors: Arduino, CH340,
# FTDI, CP210x). It re-resolves on every reconnect, so moving the board to another USB
# socket does not need a config change. A SERIAL_PORT path that is not present is
# treated the same way. Set it to pin one specific device when several boards are
# attached. Run `make ports` to see what is connected and which port would be opened.
# On macOS the path looks like /dev/cu.usbmodemXXXX.
# SERIAL_PORT=/dev/ttyACM0
# false -> never auto-detect; use SERIAL_PORT only
# SERIAL_PORT_AUTO=false
