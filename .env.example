# nfc-scan configuration — copy to .env and edit. All values are optional;
# the defaults shown match the code. Nothing here is a secret by default.
# Load it however you run the service (e.g. systemd EnvironmentFile=, or `set -a; . ./.env`).
#
# Three things read this file and they parse it differently: systemd
# (EnvironmentFile=), a shell (`. ./.env`) and Docker Compose (env_file). So keep
# every comment on its own line, never after a value, and double-quote any value
# that contains a space.

# --- Database (backend/db.py) ---
# Dev container default is localhost:5433 (see README). Override to point elsewhere.
# Note: under `make up` (docker-compose) the backend reaches Postgres as host=db
# port=5432 — compose overrides this value, so leave it as-is for local runs.
DB_DSN="dbname=attendance user=attendance password=attendance host=localhost port=5433"

# --- Face match, Step 6 (backend/face.py) ---
FACE_MATCH_ENABLED=true
# cosine cutoff; calibrate from logs
FACE_THRESHOLD=0.5
# USB webcam; set 1 if it enumerates as video1
CAMERA_INDEX=0
CAMERA_WARMUP_FRAMES=5
CAMERA_PROBE_FRAMES=5
MIN_FACE_PX=80
# detector input; raise (448/640) for far/small faces
FACE_DET_SIZE=320
# drives BOTH face + liveness; auto-falls back to CPU
USE_GPU=false

# --- Liveness / anti-spoof, Step 7 (backend/liveness.py) ---
LIVENESS_ENABLED=true
# unset -> model argmax verdict; set a p_live cutoff after calibration
# LIVENESS_THRESHOLD=
# defaults to backend/models/anti_spoof
# LIVENESS_MODEL_DIR=

# --- Guardian email, Step 8 (backend/notify.py) ---
# true -> email guardians; false -> console-only
NOTIFY_EMAIL_ENABLED=false
# required to send
SMTP_HOST=
# 465 -> implicit SSL, otherwise STARTTLS
SMTP_PORT=587
# omit for an open relay / local debug server
SMTP_USER=
SMTP_PASSWORD=
# defaults to SMTP_USER
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT=10

# --- 2FA enforcement, Step 9 (backend/decision.py) ---
# true -> a failed 2nd factor is rejected (not counted present)
ENFORCE_2FA=false

# --- Perception service, Step 30 / Flow track (backend/perception.py) ---
# Continuous camera-owner pipeline (detect -> track -> recognize once per track).
# Default ON: camera runs at boot, /tap logs card-only `unverified` and enqueues
# for async face correlation (matcher, Step 31). Set false for headless / no-cam.
PERCEPTION_ENABLED=true
# unset -> CAMERA_INDEX; set a video file to run offline
# PERCEPTION_SOURCE=
# IoU to associate a detection with an existing track
TRACK_IOU_THRESH=0.3
# frames a track survives unmatched before it's dropped
TRACK_MAX_MISSES=15
# loop-rate cap
PERCEPTION_FPS=15

# --- Tap↔face matcher, Step 31 (backend/matcher.py) ---
# Correlates buffered taps with recognized faces within the window (Hungarian).
# keep wider than serial-buffering tap delay (design-notes §3)
ASSOC_WINDOW_SEC=4
# debounce duplicate/held-card reads per uid
TAP_COOLDOWN_SEC=2
# cosine cutoff for tap↔face; defaults to FACE_THRESHOLD
# MATCH_THRESHOLD=
# similarity to name a cardless tailgater; defaults to FACE_THRESHOLD
# TAILGATE_NAME_THRESHOLD=
# how often the matcher resolves ripe taps/faces
RESOLVE_INTERVAL_SEC=0.5
# bounded face buffer (drop oldest under backpressure)
MAX_FACE_BUFFER=256

# --- Register guided-capture gate (GET /api/perception/state, Register.tsx) ---
# Live quality check from perception's own detections; drives capture-button gating.
# mean face brightness (0–255) below this -> "not enough light"
REGISTER_BRIGHT_LOW=55
# above this -> "too bright / backlit"
REGISTER_BRIGHT_HIGH=215
# face-center offset (0 centered .. 1 edge) above this -> "center yourself"
REGISTER_CENTER_MAX=0.45

# --- Identity & matching, Step 33 (backend/enroll.py) ---
# cosine at/above which enroll warns of a duplicate; defaults to FACE_THRESHOLD
# DUP_ENROLL_THRESHOLD=
# flag references older than N days for re-enroll (0 = off)
REENROLL_AFTER_DAYS=0

# --- Privacy & compliance, Step 20 (backend/privacy.py) ---
# Consent gate for minors' biometrics. OFF by default (dev/back-compat); turn ON in
# production BEFORE enrolling real children — then enroll + face match require a
# recorded face_consent (taps still log NFC-only without it).
FACE_CONSENT_REQUIRED=false
# Data retention (0/unset = keep forever). Applied by `make purge` (or a cron).
# delete whole logs older than N days
ATTENDANCE_RETENTION_DAYS=0
# null raw face/liveness scores older than N days (keep the row)
SCORE_RETENTION_DAYS=0

# --- Attendance sessions, Step 21 (backend/db.py) ---
# HH:MM cutoff for "late" marking on first check-in (empty = disabled)
LATE_CUTOFF=08:00

# --- Operator API + live tap stream, Step 11 (backend/main.py) ---
# Shared token guarding /api/* (reads + writes). Unset -> API is OPEN (dev only).
# Set a long random value in production. WebSocket /ws/taps passes it as ?token=.
# Send on REST as `Authorization: Bearer <token>` or `X-Operator-Token: <token>`.
OPERATOR_TOKEN=

# --- Serial reader (backend/serial_reader.py) ---
# TAP_URL=http://localhost:8001/tap
